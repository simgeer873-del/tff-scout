    <script type="text/javascript">
        function autocompleteJSONParseCode(data) {
            var rows = new Array();
            var arr = data.toString().split("\n");
            for (var i = 0, dataLength = arr.length; i < dataLength; i++) {
                 var rowData = arr[i].toString().split("|");
                rows[i] = {
                    value: rowData[0],
                    label: rowData[0],
                    futbolcuID: rowData[1],
                    id :rowData[1]
                };
            }
            return rows;
        }

        function clik_lblUserName() {
            var btn = document.getElementById('ctl00_lblUserName'); 
            btn.click();
        }
    </script>
