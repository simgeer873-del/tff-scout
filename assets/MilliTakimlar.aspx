        <script>
            $(document).ready(function() 
            {    
                $("input#ctl00_txtFutbolcuArama").autocomplete({  source: function(request, response) {
                        
                        $.ajax({
                            url: "../ExternalCallBackPages/Futbolcu.aspx",
                            type: "GET",
                            data: {
                               q: request.term
                            },
                            success: function( item ) {
                                    var rows = autocompleteJSONParseCode(item);
                                    response(rows.slice(0, 100));
                              }
                            });
                          },
                          minLength: 3,
                          select:function (event, ui) {
                                if (!ui.item.value) {$("#ctl00_hdnFutbolcuArama").val("");return;}
                                $("#ctl00_hdnFutbolcuArama").val(ui.item.futbolcuID.toString());
                          }
                          
                });
                
            });
        </script>
    

